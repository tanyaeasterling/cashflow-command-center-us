# ─── Required ────────────────────────────────────────────────────────────────

# MySQL connection string
# Example: mysql://root:password@localhost:3306/caulco
DATABASE_URL=mysql://user:password@localhost:3306/caulco

# Secret used to sign session cookies — use any long random string
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Password to log into the dashboard
ADMIN_PASSWORD=your-secure-password

# ─── Optional ────────────────────────────────────────────────────────────────

# Admin display name and email (shown in the dashboard header)
ADMIN_NAME=Tanya
ADMIN_EMAIL=info@aaumedical.net

# Port (defaults to 3000)
PORT=3000
